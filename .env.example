# Docker Compose settings. Copy this file to `.env` before running `docker compose up`:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# These are placeholders for LOCAL DEVELOPMENT. NEVER commit a real `.env` file,
# and choose your own password instead of the placeholder below.

# --- PostgreSQL ---
POSTGRES_DB=tracelens
POSTGRES_USER=tracelens
POSTGRES_PASSWORD=change_me_local_only
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# dev  = demo error endpoints enabled, readable logs
# prod = demo endpoints forced off
SPRING_PROFILES_ACTIVE=dev
TRACELENS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Console log format of the backend container: structured JSON, either `logstash` or `ecs`.
LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash

# --- Frontend ---
FRONTEND_PORT=3000
# Backend address as seen by the browser. Baked into the frontend at build time.
VITE_API_BASE_URL=http://localhost:8080
