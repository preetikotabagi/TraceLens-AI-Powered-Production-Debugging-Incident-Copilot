# Backend environment variables (used when running with `mvn spring-boot:run`).
# Copy to `.env` and adjust. NEVER commit a real `.env` file.
# Spring Boot does not read .env files itself; export these in your shell
# or set them in your IDE run configuration.

# Database connection
DB_URL=jdbc:postgresql://localhost:5432/tracelens
DB_USERNAME=tracelens
DB_PASSWORD=change_me

# HTTP
SERVER_PORT=8080
# Comma-separated browser origins allowed to call the API
TRACELENS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Spring profile: dev (demo endpoints + readable logs) or prod (JSON logs, demo forced off)
SPRING_PROFILES_ACTIVE=dev

# Development-only demo error generator. Must be false in production.
TRACELENS_DEMO_ENABLED=false
